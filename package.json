{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=24",
		"pnpm": ">=12"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "biome check . && eslint src",
		"lint:fix": "biome check --write . && eslint src --fix",
		"format": "prettier --write 'src/**/*.svelte'",
		"type:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"ci:lint": "biome ci . && eslint src",
		"test": "vitest run"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"effect": "4.0.5",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1"
	}
}
